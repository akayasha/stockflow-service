# StockFlow backend - sample environment variables.
# Copy this file to `.env` and adjust for your environment.
# Do NOT commit `.env` - it contains real secrets.

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/stockflow
DB_USERNAME=stockflow
DB_PASSWORD=stockflow

# --- HTTP server ---
SERVER_PORT=8080

# --- JWT ---
# Must be at least 32 bytes for HS256.
# Generate a real secret with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-real-secret-at-least-32-bytes-long
JWT_EXPIRATION_MINUTES=1440

# --- Business ---
# Tax rate applied to invoice subtotals. 0.11 = 11%.
TAX_RATE=0.11
# Seed a demo user (demo@stockflow.dev / Demo1234!) and a handful of products on startup.
SEED_DEMO_DATA=true
